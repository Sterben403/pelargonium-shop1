# Copy to .env and change the values before a real launch.
ADMIN_PASSWORD=pelargonium2026
SECRET_KEY=replace-with-a-long-random-string
TOKEN_TTL_HOURS=12

# PostgreSQL (docker compose up -d db). SQLite also works: sqlite:///./pelargonium.db
DATABASE_URL=postgresql+psycopg://pelargonium:pelargonium@localhost:5433/pelargonium

# Sites allowed to call the API from the browser: local dev + Tilda pages.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*tilda\.(ws|cc)

# Secret that the Tilda form webhook must send (field "token")
TILDA_WEBHOOK_TOKEN=replace-with-another-random-string

MAX_UPLOAD_MB=8

# Smart search with a local model (Ollama, `ollama pull qwen2.5:3b`). Off by default.
AI_SEARCH_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:3b
